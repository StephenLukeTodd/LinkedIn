# =============================================================================
# Azure Kubernetes Service (AKS) with Key Vault Integration
# =============================================================================
# 
# Copy this file to terraform.tfvars and update with your actual values
#
# Required Variables:
# - appId: Service Principal Client ID for AKS cluster authentication
# - password: Service Principal Client Secret for AKS cluster authentication  
# - tenant_id: Azure AD Tenant ID for Key Vault access
#
# Get your values with:
# az account show --query tenantId -o tsv
# az ad sp create-for-rbac --skip-assignment
# =============================================================================

# Azure Service Principal Configuration
appId     = "your-service-principal-app-id-here"
password  = "your-service-principal-password-here"
tenant_id = "your-azure-ad-tenant-id-here"
